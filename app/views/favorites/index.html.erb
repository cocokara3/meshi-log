<% content_for :title, "お気に入り | めしログ" %>

<div class="page-header">
  <h1 class="page-title">❤️ お気に入り一覧</h1>
</div>

<% if @favorites.empty? %>
  <div class="empty-state">
    <p>まだお気に入りがありません</p>
    <%= link_to 'お店を探す', restaurants_path, class: "btn-primary" %>
  </div>
<% else %>
  <div class="cards-grid">
    <% @favorites.each do |restaurant| %>
      <%= render restaurant %>
    <% end %>
  </div>
<% end %>