<div class="auth-container">
  <div class="auth-logo">
    <div class="logo-icon">🍽️</div>
    <h1 class="auth-title">めしログ</h1>
    <p class="auth-subtitle">食の記憶を記録しよう</p>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="form-group">
      <%= f.label :email, 'メールアドレス', class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input", placeholder: "hello@example.com" %>
    </div>

    <div class="form-group">
      <%= f.label :password, 'パスワード', class: "form-label" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "form-input", placeholder: "••••••••" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem;">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, 'ログインを記憶する', style: "font-size: 0.875rem; color: #475569;" %>
      </div>
    <% end %>

    <%= f.submit 'ログイン', class: "btn-submit" %>
  <% end %>

  <%= button_to 'ゲストログイン', users_guest_sign_in_path, method: :post, class: "btn-guest" %>

  <p class="auth-links">
    アカウントをお持ちでない方は <%= link_to '新規登録', new_user_registration_path, class: "link-primary" %>
  </p>
</div>