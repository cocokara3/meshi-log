<div class="auth-container" style="max-width: 520px;">
  <div class="auth-logo">
    <h1 class="auth-title">アカウント設定</h1>
    <p class="auth-subtitle">メールアドレスやパスワードを変更できます</p>
  </div>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="form-group">
      <%= f.label :email, 'メールアドレス', class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :password, '新しいパスワード', class: "form-label" %>
      <p style="font-size: 0.75rem; color: #94a3b8; margin: 0 0 0.4rem;">変更しない場合は空白のまま</p>
      <%= f.password_field :password, autocomplete: "new-password", class: "form-input" %>
      <% if @minimum_password_length %>
        <p style="font-size: 0.75rem; color: #94a3b8; margin: 0.25rem 0 0;">（<%= @minimum_password_length %>文字以上）</p>
      <% end %>
    </div>

    <div class="form-group">
      <%= f.label :password_confirmation, '新しいパスワード（確認）', class: "form-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :current_password, '現在のパスワード', class: "form-label" %>
      <p style="font-size: 0.75rem; color: #94a3b8; margin: 0 0 0.4rem;">変更を確定するために必要です</p>
      <%= f.password_field :current_password, autocomplete: "current-password", class: "form-input" %>
    </div>

    <%= f.submit '変更を保存', class: "btn-submit" %>
  <% end %>

  <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #f1f5f9;">
    <p style="font-size: 0.875rem; color: #94a3b8; margin-bottom: 0.75rem;">アカウントを削除する場合はこちら</p>
    <%= button_to 'アカウントを削除', registration_path(resource_name), data: { confirm: '本当に削除しますか？', turbo_confirm: '本当に削除しますか？' }, method: :delete, class: "btn-delete" %>
  </div>

  <p class="auth-links">
    <%= link_to '← 一覧に戻る', restaurants_path, class: "link-primary" %>
  </p>
</div>