<h1>お店一覧</h1>

<%# 並び替え %>
<div>
  <%= link_to '新着順', restaurants_path(order: 'created_at_desc') %>
  <%= link_to '評価が高い順', restaurants_path(order: 'rating_desc') %>
  <%= link_to '評価が低い順', restaurants_path(order: 'rating_asc') %>
</div>

<%# 検索フォーム %>
<%= search_form_for @q, url: restaurants_path do |f| %>
  <div>
    <%= f.search_field :name_or_genre_cont, placeholder: 'お店・ジャンルで検索' %>
  </div>
  <%= f.submit '検索' %>
<% end %>

<div id="restaurants">
  <% @restaurants.each do |restaurant| %>
    <%= render restaurant %>
    <p>
      <%= link_to '詳細', restaurant %>
    </p>
  <% end %>
</div>

<%= paginate @restaurants %>

<%= link_to '新規投稿', new_restaurant_path %>