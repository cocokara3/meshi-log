<% content_for :title, "お店一覧 | めしログ" %>

<div class="page-header">
  <h1 class="page-title">お店一覧</h1>
  <div class="sort-links">
    <%= link_to '新着順', restaurants_path(order: 'created_at_desc'), class: "sort-link" %>
    <%= link_to '評価が高い順', restaurants_path(order: 'rating_desc'), class: "sort-link" %>
    <%= link_to '評価が低い順', restaurants_path(order: 'rating_asc'), class: "sort-link" %>
  </div>
</div>

<%= search_form_for @q, url: restaurants_path, html: { class: "search-form" } do |f| %>
  <%= f.search_field :name_or_genre_cont, placeholder: 'お店の名前・ジャンルで検索', class: "search-input" %>
  <%= f.submit '検索', class: "search-submit" %>
<% end %>

<div class="cards-grid">
  <% @restaurants.each do |restaurant| %>
    <%= render restaurant %>
  <% end %>
</div>

<div class="pagination">
  <%= paginate @restaurants %>
</div>