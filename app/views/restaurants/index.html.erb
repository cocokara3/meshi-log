<h1>お店一覧</h1>

<%# 検索フォーム %>
<%= search_form_for @q, url: restaurants_path do |f| %>
  <div>
    <%= f.label :name_cont, 'お店の名前' %>
    <%= f.search_field :name_cont, placeholder: 'お店の名前で検索' %>
  </div>
  <div>
    <%= f.label :genre_cont, 'ジャンル' %>
    <%= f.search_field :genre_cont, placeholder: 'ジャンルで検索' %>
  </div>
  <%= f.submit '検索' %>
<% end %>

<div id="restaurants">
  <% @restaurants.each do |restaurant| %>
    <%= render restaurant %>
    <p>
      <%= link_to '詳細', restaurant %>
    </p>
  <% end %>
</div>

<%= paginate @restaurants %>

<%= link_to '新規投稿', new_restaurant_path %>