<div class="card">
  <% if restaurant.image.attached? %>
    <%= image_tag restaurant.image, class: "card-image" %>
  <% else %>
    <%= image_tag 'salad.png', class: "card-image" %>
  <% end %>

  <div class="card-body">
    <div class="card-header">
      <h3 class="card-title"><%= restaurant.name %></h3>
      <span class="card-rating"><%= '★' * restaurant.rating + '☆' * (5 - restaurant.rating) %></span>
    </div>

    <p class="card-meta"><%= restaurant.genre %> ・ <%= restaurant.visited_at %></p>

    <% if restaurant.comment.present? %>
      <p class="card-comment"><%= restaurant.comment %></p>
    <% end %>

    <% if restaurant.tags.any? %>
      <div class="card-tags">
        <% restaurant.tags.each do |tag| %>
          <%= link_to tag.name, restaurants_path(q: { tags_name_eq: tag.name }), class: "tag-link" %>
        <% end %>
      </div>
    <% end %>

    <div class="card-footer">
      <%= link_to '詳細を見る', restaurant, class: "link-primary" %>
      <% if user_signed_in? %>
        <% if current_user.favorites.exists?(restaurant: restaurant) %>
          <%= button_to '❤️', restaurant_favorite_path(restaurant), method: :delete, class: "btn-favorite" %>
        <% else %>
          <%= button_to '🤍', restaurant_favorite_path(restaurant), method: :post, class: "btn-favorite" %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>